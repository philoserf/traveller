{
  "name": "traveller",
  "compatibility_date": "2026-10-12",
  // Runs before every deploy, on a Mac or in Workers Builds. build.sh is the
  // whole build and says why each step is there.
  "build": {
    "command": "bash build.sh",
  },
  "main": "./worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
  },
  // Mondays 09:00 UTC (05:00 Eastern in summer, 04:00 in winter): rebuild so
  // future-dated posts go live. DEPLOY_HOOK is a secret: see the README.
  "triggers": { "crons": ["0 9 * * 1"] },
  // The custom domain is the only address: no workers.dev, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs, free tier: keeps the Worker's errors, including a failed cron, for 3 days.
  "observability": { "enabled": true },
  "routes": [{ "pattern": "traveller.philoserf.com", "custom_domain": true }],
}
